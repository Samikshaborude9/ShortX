# ShortX Environment Variables

# API Settings
PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://shortx:shortx_dev_pass@localhost:5432/shortx
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shortx
DB_PASSWORD=shortx_dev_pass
DB_NAME=shortx

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# JWT Authentication
JWT_SECRET=super_secret_shortx_jwt_key_2026
JWT_REFRESH_SECRET=super_secret_shortx_refresh_key_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
